# ==========================================
# ApplyFlow Backend Environment Variables
# ==========================================

# 1. Google Sheet ID
# The ID from your Google Sheet URL (e.g., https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# 2. Google Credentials JSON
# If you are hosting this backend on Render/Heroku/AWS, copy the entire contents of 
# your credentials.json file starting exactly from { to } and paste it below. 
# This allows you to securely host without uploading the credentials.json file.
# 
# (Note: If you are running locally, you can ignore this and just keep your 
# credentials.json file inside the Backend folder.)
GOOGLE_CREDENTIALS_JSON='{ "type": "service_account", "project_id": "...", ... }'
